# GitHub App ID for credential broker
GITHUB_APP_ID=

# Shared secret for credential broker authentication (generate with: openssl rand -hex 32)
# ⚠️ CRITICAL: This value is IMMUTABLE once dev containers are created.
#              Changing it requires regenerating ALL dev container credentials.
#              Generate once and never change.
BROKER_SECRET=

# Parent directory on the HOST that holds per-zone workspace subdirs
# (e.g. ${WORKSPACE_HOST_BASE}/workspace-core, ${WORKSPACE_HOST_BASE}/workspace-perimeter).
# Each zone container bind-mounts its own subdir at WORKSPACE_ROOT.
# Migration: mv ~/workspace ~/workspace-core ; mkdir ~/workspace-perimeter
WORKSPACE_HOST_BASE=/home/lucian

# CONTAINER-INTERNAL workspace path — canonical path inside every zone container.
# Must match cwd values in threads.json. Kept identical to its pre-AD7 value so
# agents' muscle memory stays intact.
WORKSPACE_ROOT=/home/lucian/workspace

# Absolute path on the HOST to this borg checkout (e.g. /home/lucian/workspace-core/borg).
# Used by the dashboard's zone supervisor to build correct bind-mount source paths
# (since the docker-proxy resolves bind sources on the host filesystem, not in-container).
BORG_REPO_ROOT=/home/lucian/workspace-core/borg

# Optional: path to Claude CLI credentials file (defaults to ~/.claude/.credentials.json)
# CLAUDE_CREDENTIALS=/path/to/.claude/.credentials.json

# Public hostname or IP of this server — used in SSH config snippets for dev containers
# (NOT the Cloudflare tunnel URL — this is what devs SSH to directly)
PUBLIC_HOST=

# Optional: Cloudflare Tunnel token for HTTPS dashboard access
# TUNNEL_TOKEN=

# Host docker group GID — needed for docker-proxy socket access
# Find with: getent group docker | cut -d: -f3
DOCKER_GID=

# ── Sidecar Services ──
# Uncomment to enable sidecar services (docker-compose.services.yml)
# COMPOSE_FILE=docker-compose.yml:docker-compose.services.yml

