FROM node:22-slim

WORKDIR /app

# Infra only needs Node.js runtime — no git, gh, or Claude SDK
RUN apt-get update && \
    apt-get install -y --no-install-recommends bash ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# ── Dependency layer ──
COPY package.json package-lock.json tsconfig.json ./
RUN npm ci

# ── Build layer ──
COPY src/ ./src/
RUN npm run build && npm prune --production

# ── Runtime setup ──
RUN mkdir -p /home/node/.claude && \
    chown -R node:node /app /home/node

USER node

# Infra runs telegram-client only (no queue-processor, no SDK sessions)
CMD ["node", "dist/telegram-client.js"]
